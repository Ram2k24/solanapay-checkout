// SolanaPay Checkout database schema.
// Conventions:
// - Tables and columns are snake_case in PostgreSQL (@@map / @map).
// - IDs are UUIDv7 (time-ordered, index-friendly), generated by Prisma.
// - Money is BIGINT in token base units (USDC: 1.00 = 1_000_000). Never floats.
// - Timestamps are timestamptz.
// - Constraints Prisma can't express (CHECKs, partial unique indexes, the
//   append-only audit trigger) live in the migration SQL. See docs/database.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SolanaNetwork {
  DEVNET
  TESTNET
  MAINNET

  @@map("solana_network")
}

enum Currency {
  USDC

  @@map("currency")
}

enum InvoiceStatus {
  DRAFT
  PENDING
  CONFIRMING
  PAID
  EXPIRED
  FAILED

  @@map("invoice_status")
}

// Commitment level at which the payment's transaction was last verified.
enum Commitment {
  CONFIRMED
  FINALIZED

  @@map("commitment")
}

// What a merchant counter numbers: invoices (INV-2026-00001) or auto-generated
// order IDs (ORD-2026-00001).
enum CounterKind {
  INVOICE
  ORDER

  @@map("counter_kind")
}

enum ActorType {
  USER
  SYSTEM

  @@map("actor_type")
}

// A person who signs in (with their wallet, Phase 4).
model User {
  id            String    @id @default(uuid(7)) @db.Uuid
  walletAddress String    @unique @map("wallet_address") @db.VarChar(44)
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant?
  sessions Session[]

  @@map("users")
}

// A business that receives payments. One per user for the MVP.
model Merchant {
  id              String   @id @default(uuid(7)) @db.Uuid
  ownerUserId     String   @unique @map("owner_user_id") @db.Uuid
  name            String   @db.VarChar(120)
  email           String?  @db.VarChar(254)
  defaultCurrency Currency @default(USDC) @map("default_currency")
  notifyByEmail   Boolean  @default(false) @map("notify_by_email")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner    User      @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  wallets         Wallet[]
  invoices        Invoice[]
  invoiceCounters InvoiceCounter[]

  @@map("merchants")
}

// Payout wallets (public addresses only; private keys are never stored).
model Wallet {
  id         String   @id @default(uuid(7)) @db.Uuid
  merchantId String   @map("merchant_id") @db.Uuid
  address    String   @db.VarChar(44)
  label      String?  @db.VarChar(60)
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, address])
  @@map("wallets")
}

model Invoice {
  id                String        @id @default(uuid(7)) @db.Uuid
  merchantId        String        @map("merchant_id") @db.Uuid
  invoiceNumber     String        @map("invoice_number") @db.VarChar(32)
  orderId           String?       @map("order_id") @db.VarChar(64)
  customerReference String?       @map("customer_reference") @db.VarChar(120)
  description       String?       @db.VarChar(500)
  // Payment terms, copied from config/settings at creation time so later
  // settings changes can never alter what an open invoice expects.
  network           SolanaNetwork
  currency          Currency
  amount            BigInt
  tokenMint         String        @map("token_mint") @db.VarChar(44)
  tokenDecimals     Int           @map("token_decimals") @db.SmallInt
  recipientWallet   String        @map("recipient_wallet") @db.VarChar(44)
  // Solana Pay reference: a unique public key that identifies this invoice's payment on-chain.
  reference         String        @unique @db.VarChar(44)
  status            InvoiceStatus
  failureReason     String?       @map("failure_reason") @db.VarChar(200)
  expiresAt         DateTime      @map("expires_at") @db.Timestamptz(3)
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(3)
  // Idempotent creation: a retried request with the same key returns the original
  // invoice; the same key with a different request body (different hash) is rejected.
  idempotencyKey    String?       @map("idempotency_key") @db.VarChar(64)
  requestHash       String?       @map("request_hash") @db.Char(64)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  payment  Payment?

  @@unique([merchantId, invoiceNumber])
  @@unique([merchantId, idempotencyKey])
  @@index([merchantId, status])
  @@index([merchantId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@index([merchantId, orderId])
  @@map("invoices")
}

// Per-merchant, per-year counters: invoice numbers (INV-2026-00001, ...) and
// auto-generated order IDs (ORD-2026-00001, ...). Incremented with
// INSERT ... ON CONFLICT DO UPDATE ... RETURNING inside the invoice-creation
// transaction; the row lock serializes concurrent creates.
model InvoiceCounter {
  merchantId String      @map("merchant_id") @db.Uuid
  kind       CounterKind @default(INVOICE)
  year       Int         @db.SmallInt
  lastValue  Int         @map("last_value")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@id([merchantId, kind, year])
  @@map("invoice_counters")
}

// A verified on-chain transfer that settled an invoice.
// Rows are created only by backend verification, never from client input.
model Payment {
  id                    String        @id @default(uuid(7)) @db.Uuid
  invoiceId             String        @unique @map("invoice_id") @db.Uuid
  signature             String        @unique @db.VarChar(88)
  network               SolanaNetwork
  reference             String        @db.VarChar(44)
  senderWallet          String        @map("sender_wallet") @db.VarChar(44)
  recipientWallet       String        @map("recipient_wallet") @db.VarChar(44)
  recipientTokenAccount String        @map("recipient_token_account") @db.VarChar(44)
  tokenMint             String        @map("token_mint") @db.VarChar(44)
  amount                BigInt
  slot                  BigInt
  blockTime             DateTime?     @map("block_time") @db.Timestamptz(3)
  commitment            Commitment
  // Paid after the invoice's expiry: recorded (never drop real money) and flagged for review.
  late                  Boolean       @default(false)
  verifiedAt            DateTime      @map("verified_at") @db.Timestamptz(3)
  finalizedAt           DateTime?     @map("finalized_at") @db.Timestamptz(3)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@map("payments")
}

// Append-only record of security- and money-relevant events.
// UPDATE and DELETE are blocked by a database trigger.
model AuditLog {
  id         BigInt    @id @default(autoincrement())
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.VarChar(64)
  action     String    @db.VarChar(64)
  entityType String    @map("entity_type") @db.VarChar(32)
  entityId   String    @map("entity_id") @db.VarChar(64)
  data       Json?
  requestId  String?   @map("request_id") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

// One-time sign-in challenge (Sign-In With Solana). The server builds the full
// message and stores it; the wallet signs exactly these bytes. Single use.
model AuthNonce {
  id            String    @id @default(uuid(7)) @db.Uuid
  nonce         String    @unique @db.VarChar(64)
  walletAddress String    @map("wallet_address") @db.VarChar(44)
  message       String    @db.VarChar(1000)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("auth_nonces")
}

// Server-side session. The cookie holds a random token; only its HMAC is stored,
// so a database leak alone does not reveal usable session tokens.
model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  userAgent String?   @map("user_agent") @db.VarChar(256)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Fixed-window request counters for rate limiting (one row per key per window).
model RateLimit {
  key         String   @db.VarChar(128)
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int

  @@id([key, windowStart])
  @@map("rate_limits")
}
