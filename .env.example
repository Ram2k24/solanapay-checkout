# =====================================================================
# SolanaPay Checkout: environment template
# Copy to .env:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.
# =====================================================================

# ---------------------------------------------------------------------
# PUBLIC: prefixed NEXT_PUBLIC_, compiled into browser JavaScript.
# Anyone can read these. NEVER put secrets or API keys here.
# ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Solana cluster: devnet | testnet | mainnet
# Single source of truth for the network, used by browser and server.
# Only devnet is supported during development.
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# RPC used by the browser for read-only lookups (balances).
# Use a key-less endpoint only, because this value is public.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

NEXT_PUBLIC_SOLANA_EXPLORER_URL=https://explorer.solana.com

# ---------------------------------------------------------------------
# SERVER-ONLY: never sent to the browser.
# ---------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info

# RPC used by the backend for payment verification.
# In production this is a provider URL (e.g. Helius) that may contain an API key.
SOLANA_RPC_URL=https://api.devnet.solana.com

# USDC mint allowlist, one per network. Source: Circle official docs
# https://developers.circle.com/stablecoins/usdc-contract-addresses
# Only these mints are ever accepted. The client can never choose a mint.
USDC_MINT_DEVNET=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
USDC_MINT_MAINNET=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Largest invoice amount accepted, in whole USDC (devnet safety cap; default 10000).
# MAX_INVOICE_AMOUNT_USDC=10000

# Signs session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Protects the payment reconciliation cron endpoint. Generate with: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------
# DATABASE (server-only)
# Local Docker Postgres, bound to 127.0.0.1 only. These dev credentials
# exist only on your machine. Production uses a managed database URL.
# ---------------------------------------------------------------------
POSTGRES_USER=solanapay
POSTGRES_PASSWORD=solanapay_dev
POSTGRES_DB=solanapay
POSTGRES_PORT=5432

DATABASE_URL=postgresql://solanapay:solanapay_dev@localhost:5432/solanapay?schema=public

# Separate database for automated tests (created by `npm run db:test:setup`).
# Tests empty its tables, so it must never point at real data. Name must end in _test.
TEST_DATABASE_URL=postgresql://solanapay:solanapay_dev@localhost:5432/solanapay_test?schema=public

# Phase 13.5: least-privilege database role (see scripts/db-app-role.sql, npm run db:role).
# The app connects as solanapay_app (DATABASE_URL, TEST_DATABASE_URL); migrations and
# test resets use the owner (MIGRATE_DATABASE_URL, TEST_MIGRATE_DATABASE_URL).
# Generate the password with: openssl rand -hex 24
APP_DB_PASSWORD=
MIGRATE_DATABASE_URL=
TEST_MIGRATE_DATABASE_URL=
