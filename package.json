{
  "name": "solanapay-checkout",
  "version": "0.1.0",
  "private": true,
  "description": "USDC checkout for merchants, powered by Solana Pay",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev | pino-pretty",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:check": "docker compose exec -T postgres sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\" -v ON_ERROR_STOP=1 -q' < scripts/db-constraint-check.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:test:setup": "./scripts/test-db-setup.sh",
    "smoke": "./scripts/smoke-test.sh",
    "db:seed": "tsx --conditions=react-server scripts/seed-dev.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@solana-program/token": "0.17.0",
    "@solana/kit": "8.3.0",
    "@solana/kit-plugin-rpc": "0.19.0",
    "@solana/kit-plugin-wallet": "0.20.0",
    "@solana/react": "8.3.0",
    "next": "16.3.6",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "overrides": {
    "mysql2": "3.24.4",
    "deepmerge-ts": "8.0.2"
  },
  "allowScripts": {
    "prisma": false,
    "@prisma/engines": false,
    "esbuild": false
  }
}
